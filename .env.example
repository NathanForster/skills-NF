# Copy this file to .env (gitignored) to change where sync-skills.ps1 installs
# things on this machine. Every key is optional: a missing or blank key keeps
# the default shown. ~ means your home folder.

# Where the shared lib\ (the docset engine) is installed, as <COMMANDS_DIR>\lib.
# Projects' build scripts look for the engine there.
# Default: ~\.claude\commands
COMMANDS_DIR=

# Semicolon-separated folders that each get a copy of every skill.
# Default: ~\.claude\skills;~\.copilot\skills
#   ~\.claude\skills    Claude Code, and Copilot in VS Code
#   ~\.copilot\skills   Copilot CLI, and Copilot in VS Code
SKILL_DIRS=
